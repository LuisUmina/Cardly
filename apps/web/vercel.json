{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/chat-live",
      "destination": "https://cardly-backend-yz2m.onrender.com/chat-live"
    },
    {
      "source": "/mcp",
      "destination": "https://cardly-backend-yz2m.onrender.com/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://cardly-backend-yz2m.onrender.com/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "https://cardly-backend-yz2m.onrender.com/.well-known/oauth-protected-resource/mcp"
    },
    {
      "source": "/v1",
      "destination": "https://cardly-backend-yz2m.onrender.com/v1/"
    },
    {
      "source": "/v1/",
      "destination": "https://cardly-backend-yz2m.onrender.com/v1/"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://cardly-backend-yz2m.onrender.com/v1/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://cardly-auth.onrender.com/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
